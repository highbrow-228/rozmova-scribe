# Скопіюй цей файл у .env і заповни під себе:
#   cp .env.example .env
#
# Обов'язковий тут лише HF_TOKEN. Усі інші змінні мають робочі значення
# за замовчуванням, тож їх можна лишити порожніми або видалити зовсім.

# Токен Hugging Face з доступом до моделі діаризації
# pyannote/speaker-diarization-community-1 - вона гейтована, тож спершу
# треба прийняти умови на її сторінці. Токен: hf.co/settings/tokens
HF_TOKEN=""

# Параметри транскрипції. Значення нижче - вони ж і за замовчуванням.
LANGUAGE=uk
SPEAKER_NUM=2
OUTPUT_FORMAT=txt

# Пристрій: порожньо = визначити автоматично (є GPU -> cuda, немає -> cpu).
DEVICE=

# Тип обчислень. float32 однаковий на CPU і GPU, тож результат не
# залежить від машини. float16 працює лише на GPU і дає той самий текст
# швидше; int8 працює скрізь, але це квантизація з втратою якості.
COMPUTE_TYPE=float32

# Підказки моделі щодо лексики. За замовчуванням порожні - тоді
# whisper працює без них узагалі. Заповни під свої записи:
#   HOTWORDS       - окремі слова й терміни через кому
#   INITIAL_PROMPT - опис контексту розмови суцільним текстом
#
# Приклад для дзвінків у службу підтримки:
#   HOTWORDS="застосунок, верифікація, картка, рахунок, IBAN, ФОП"
#   INITIAL_PROMPT="Розмова клієнта з оператором. Реєстрація в застосунку, картка, рахунок, перекази."
HOTWORDS=""
INITIAL_PROMPT=""
